        "remediation": [
          "Use PreparedStatement / parameterized queries (e.g., NamedParameterJdbcTemplate or JdbcTemplate.queryForRowSet with '?' placeholders and bound parameters) instead of string concatenation.",
          "Validate and constrain input format (e.g., allow-list characters) as defense in depth.",
          "Avoid passing raw user input through pass-through helper methods that give a false sense of sanitization; ensure any sanitization step is SQL-context specific."
        ]
      }
