        ],
        "score_breakdown": {
          "severity:ERROR": 0.35,
          "confidence:MEDIUM": 0.1,
          "impact:MEDIUM": 0.05,
          "likelihood:HIGH": 0.1,
          "cwe_top25": 0.1,
          "subcategory:vuln": 0.1,
