        "remediation": [
          "Use parameterized queries with bind variables (e.g., '{call proc(?)}') and set values via PreparedStatement/CallableStatement setString/setObject methods instead of string concatenation.",
          "Validate and constrain the expected parameter to a strict allow-list (e.g., expected format/length) before use.",
          "Avoid building SQL/callable statement text dynamically from any request-derived data."
        ]
      }
