        "remediation": [
          "Replace java.sql.Statement with a java.sql.PreparedStatement and bind 'bar' as a parameter (e.g., using '?' placeholders and setString).",
          "Validate/whitelist the parameter value against expected format (e.g., alphanumeric username) before use.",
          "Avoid dynamically resolving parameter names to fetch values from arbitrary user input; use fixed, expected parameter names."
        ]
      }
