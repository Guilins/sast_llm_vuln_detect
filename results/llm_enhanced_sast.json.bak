        "remediation": [
          "Canonicalize the resolved file path (e.g., File.getCanonicalPath()) and verify it resides within the intended TESTFILES_DIR before opening it.",
          "Reject or strip path traversal sequences ('..', absolute path prefixes) from the header-derived value.",
          "Use org.apache.commons.io.FilenameUtils.getName(...) to strip any directory components and only allow a bare filename.",
          "Maintain an allow-list of permitted file names/extensions instead of trusting header input directly.",
          "Ensure the doSomething() helper does not simply pass through untrusted input without validation."
        ]
      }
