        "remediation": [
          "Use parameterized queries with '?' placeholders and bind the user input via setString()/setObject() instead of string concatenation.",
          "Validate/whitelist the input against expected format (e.g., alphanumeric only) if it must be used in a dynamic context.",
          "Avoid building CallableStatement SQL text from untrusted input; if dynamic procedure names are required, validate against a strict allow-list of known procedure names."
        ]
      }
