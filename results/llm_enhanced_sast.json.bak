          "decision": "escalate",
          "reason": "User-controlled HTTP parameter flows through doSomething() into 'bar' variable, which is directly concatenated into an LDAP filter string without sanitization, enabling LDAP injection despite the presence of a sanitizer elsewhere in the met",
          "error": null,
          "elapsed_seconds": 1.77
