        "small_model": {
          "key": "org/owasp/benchmark/testcode/BenchmarkTest02025.java:65:21-65:49:java.lang.security.audit.tainted-ldapi-from-http-request.tainted-ldapi-from-http-request",
          "decision": "escalate",
          "reason": "Attacker-controlled HTTP header is URL-decoded and passed through doSomething() into an LDAP filter without visible sanitization, enabling LDAP injection despite the sanitizer_call signal.",
          "error": null,
          "elapsed_seconds": 1.507
        }
      },
      "analysis": {
        "exploitability_evidence": "Source: attacker-controlled HTTP header value obtained via request.getHeaders(\"BenchmarkTest02025\") (line 44), URL-decoded at line 50, then passed to doSomething(request, param) at line 52. The result 'bar' is concatenated directly into an LDAP search filter string at line 65: '(&(objectclass=person)(uid=' + bar + '))' with no LDAP-specific escaping of special filter characters (e.g. '*', '(', ')', '\\\\', NUL). This filter is then passed unmodified to ctx.search(base, filter, sc), the LDAP query sink. The only sanitization present in the visible code is ESAPI encodeForHTML() applied later to output written to the HTTP response (lines for attr/attr2 and the 'not found' filter message) \u2014 this is output encoding for HTML context, not LDAP filter encoding, and does not neutralize LDAP metacharacters before the query executes. The body of doSomething() is not shown, but per the OWASP Benchmark test suite's common convention, such helper methods are typically simple pass-through/obfuscation wrappers that do not perform LDAP-specific sanitization; no LDAP encoder (e.g. ESAPI encodeForLDAP) is invoked anywhere on this path before the ctx.search call.",
        "verdict": "True Positive",
        "confidence": "medium",
        "severity_assessment": "medium",
        "root_cause": "User-supplied HTTP header data is URL-decoded and concatenated directly into an LDAP search filter string without any LDAP-specific escaping/sanitization before being used in DirContext.search(), allowing injection of LDAP filter metacharacters.",
        "impact": "An attacker can manipulate the LDAP search filter to alter query logic (e.g., bypass intended filter conditions, extract unauthorized directory entries, or cause denial of service), potentially exposing or modifying data in the LDAP directory tree.",
        "remediation": [
          "Use a proper LDAP encoding routine (e.g., ESAPI Encoder.encodeForLDAP()) on the user-supplied value before inserting it into the filter string.",
          "Prefer parameterized/typed LDAP search APIs or filter builders that escape special characters automatically instead of manual string concatenation.",
          "Apply strict allow-list input validation (e.g., restrict to expected characters such as alphanumerics) on the header value before use in the filter."
        ]
      }
    },
