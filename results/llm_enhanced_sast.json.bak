        "remediation": [
          "Use a parameterized PreparedStatement with bind variables for USERNAME/PASSWORD instead of string concatenation.",
          "Avoid using java.sql.Statement.execute() with user-influenced strings.",
          "Apply strict input validation/allow-listing on header values used in queries.",
          "Enforce least-privilege database accounts to limit blast radius of any injection."
        ]
      }
