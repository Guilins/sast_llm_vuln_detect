        "remediation": [
          "Use a parameterized query for both USERNAME and PASSWORD (e.g., bind 'bar' via statement.setString(2, bar) instead of string concatenation).",
          "Avoid building SQL strings via concatenation of any user-controlled data.",
          "Apply strict input validation/allow-listing on the parameter if it must be used outside of a bind variable.",
          "Adopt an ORM or query builder that enforces parameterization by default."
        ]
      }
