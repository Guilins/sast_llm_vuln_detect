        },
        "small_model": {
          "key": "org/owasp/benchmark/testcode/BenchmarkTest00021.java:58:21-58:58:java.lang.security.audit.tainted-ldapi-from-http-request.tainted-ldapi-from-http-request",
          "decision": "escalate",
          "reason": "Untrusted HTTP parameter is directly concatenated into LDAP filter string without sanitization, enabling LDAP injection despite presence of parameterized placeholder {0} for a different filter component.",
          "error": null,
          "elapsed_seconds": 1.712
        }
      },
      "analysis": {
        "exploitability_evidence": "Source: request.getParameter(\"BenchmarkTest00021\") assigned to 'param' (defaulted to empty string if null, but otherwise unmodified). This value is directly concatenated into the LDAP search filter string: 'filter = \"(&(objectclass=person))(|(uid=\" + param + \")(street={0}))\"'. This filter is then passed directly to ctx.search(base, filter, filters, sc) at line 58, the flagged sink. No escaping, validation, whitelisting, or LDAP-specific encoding (e.g., ESAPI encodeForLDAP) is applied to 'param' before concatenation. The parameterized placeholder {0} is only used for the unrelated 'street' attribute (bound to a hardcoded constant), providing no protection for the 'uid' portion where the tainted data is inserted via string concatenation. An attacker can inject LDAP filter metacharacters (e.g., '*)(uid=*))(|(uid=*') to alter the search filter logic, bypassing intended query constraints.",
        "verdict": "True Positive",
        "confidence": "high",
        "severity_assessment": "medium",
        "root_cause": "User-supplied HTTP parameter is concatenated directly into an LDAP search filter string without any sanitization or use of LDAP-safe parameter binding for that portion of the filter, enabling injection of LDAP filter metacharacters.",
        "impact": "An attacker could manipulate the LDAP filter logic to bypass search constraints, extract unauthorized directory entries, enumerate LDAP tree contents, or in some configurations modify query semantics to access data outside the intended 'uid' scope.",
        "remediation": [
          "Use parameterized LDAP filters for all user-controlled inputs (i.e., replace 'uid=' + param with a placeholder like uid={1} and pass param via the filters Object[] array to ctx.search).",
          "Alternatively, apply LDAP-specific encoding (e.g., ESAPI's encodeForLDAP or Codec.encode for LDAP DN/filter contexts) to the parameter before concatenation.",
          "Validate/whitelist the expected format of the 'BenchmarkTest00021' parameter (e.g., alphanumeric only) before using it in any LDAP query.",
          "Apply the principle of least privilege to the LDAP bind account used for searches to limit the impact of a successful injection."
        ]
      }
    },
