        ],
        "method_lines": [
          40,
          71
        ],
        "score_breakdown": {
          "severity:WARNING": 0.2,
          "confidence:MEDIUM": 0.1,
          "impact:MEDIUM": 0.05,
          "likelihood:MEDIUM": 0.05,
          "subcategory:vuln": 0.1,
          "signal:xss": 0.15,
          "signal:trust_boundary": 0.1,
          "taint_source": 0.1,
          "sanitizer_hint": -0.1
        }
      },
      "analysis": {
        "exploitability_evidence": "Source: request.getHeaderNames()/request.getHeaders(name) - the name of the first non-standard HTTP header is attacker-controlled and assigned to `param`. This flows into `new Test().doSomething(request, param)` (body not shown, but per Benchmark harness pattern this method typically echoes/derives from the tainted param without validation) producing `bar`. `bar` is then passed directly to `request.getSession().putValue(\"userid\", bar)` at line 64, which is the flagged trust-boundary sink. The only sanitizer applied on this data, `Utils.encodeForHTML(bar)`, is used solely for the later HTML output in the response writer \u2014 it is not applied before the session storage call. Therefore untrusted header-derived data is placed into the session with no validation/sanitization relevant to CWE-501.",
        "verdict": "True Positive",
        "confidence": "medium",
        "severity_assessment": "low",
        "root_cause": "Attacker-controlled HTTP header name is used to derive a value that is stored directly into the HttpSession via putValue without any validation or sanitization specific to trust-boundary concerns; the only sanitization present (HTML encoding) is applied to a different sink (response output), not to the session storage call.",
        "impact": "Untrusted, attacker-influenced data becomes part of the trusted session state, which can lead to trust boundary violations such as session data poisoning, inconsistent trust assumptions in downstream code that reads this session attribute as if it were validated, and potential privilege/logic issues if that session value is later used in security-sensitive decisions.",
        "remediation": [
          "Validate and canonicalize any user-controlled input (including HTTP header values/names) against a strict allow-list before storing it in the session.",
          "Avoid storing raw request-derived values in session attributes; store only validated, minimal, and typed data.",
          "If the value must be stored, apply context-appropriate sanitization/validation before the putValue call, not just before output rendering.",
          "Consider using session attribute keys/values that are generated or validated server-side rather than directly derived from client-supplied headers."
        ]
      }
    },
    {
